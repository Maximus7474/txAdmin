{
  "name": "txadmin",
  "version": "1.0.0",
  "description": "The official FiveM/RedM server management platform used by tens of thousands of servers.",
  "module": "./core/index.js",
  "type": "module",
  "workspaces": [
    "core",
    "nui",
    "panel",
    "shared"
  ],
  "scripts": {
    "build": "bunx rimraf dist tmp_core_tsc && bun run build --filter nui && bun run build --filter panel && bun run build --filter core && bun run license:distfile",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "locale:rebase": "bun scripts/locale-utils.js rebase",
    "locale:check": "bun scripts/locale-utils.js check --color",
    "license:report": "bunx rimraf .reports/license && mkdir \".reports/license\" && bun run --filter '*' license:report",
    "license:list": "bun scripts/list-licenses.js",
    "license:distfile": "bunx generate-license-file --ci --no-spinner --input package.json --output dist/THIRD-PARTY-LICENSES.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabarra/txAdmin.git"
  },
  "author": "André Tabarra",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tabarra/txAdmin/issues"
  },
  "homepage": "https://txadmin.gg/",
  "dependencies": {
    "chalk": "^5.3.0",
    "dequal": "^2.0.3",
    "humanize-duration": "^3.32.1",
    "jsonrepair": "^3.11.2",
    "lodash-es": "^4.17.21",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/humanize-duration": "^3.27.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.7.5",
    "esbuild": "~0.24.0",
    "eslint": "^9.12.0",
    "generate-license-file": "^3.5.1",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.6.3",
    "utility-types": "^3.11.0",
    "vitest": "^2.1.2"
  }
}
